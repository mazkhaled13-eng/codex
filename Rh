<!DOCTYPE html><html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Gestion du Personnel — Fichier Unique</title>
  <style>
    :root{
      --bg:#0f172a;          /* slate-900 */
      --panel:#111827;       /* gray-900 */
      --muted:#1f2937;       /* gray-800 */
      --card:#0b1226;        /* custom */
      --text:#e5e7eb;        /* gray-200 */
      --soft:#94a3b8;        /* slate-400 */
      --accent:#22c55e;      /* green-500 */
      --accent-2:#06b6d4;    /* cyan-500 */
      --danger:#ef4444;      /* red-500 */
      --warning:#f59e0b;     /* amber-500 */
      --ok:#10b981;          /* emerald-500 */
      --shadow: 0 10px 30px rgba(0,0,0,.25);
      --radius: 16px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; background:linear-gradient(120deg, #0b1020, #0a132a 60%, #0b1b2e);
      color:var(--text); font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      letter-spacing:.2px;
    }
    .app{
      display:grid; grid-template-rows:auto 1fr; min-height:100dvh;
    }
    header{
      display:flex; align-items:center; gap:16px; padding:18px 22px; position:sticky; top:0; z-index:5;
      background:linear-gradient(180deg, rgba(15,23,42,.9), rgba(15,23,42,.6)); backdrop-filter: blur(10px);
      border-bottom:1px solid rgba(148,163,184,.15);
    }
    header .brand{display:flex; align-items:center; gap:10px}
    .logo{width:36px; height:36px; border-radius:12px; display:grid; place-items:center; color:#001b14;
      background:conic-gradient(from 210deg, #22c55e, #06b6d4, #22c55e);
      box-shadow:0 0 0 2px rgba(34,197,94,.25), inset 0 0 18px rgba(255,255,255,.28);
      font-weight:900
    }
    h1{font-size:20px; margin:0}
    .sub{color:var(--soft); font-size:12px}
    .wrap{display:grid; grid-template-columns: 420px 1fr; gap:18px; padding:18px;}
    @media (max-width: 1100px){ .wrap{ grid-template-columns: 1fr; } }.card{background:linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.01)); border:1px solid rgba(148,163,184,.12); border-radius:var(--radius); box-shadow:var(--shadow)}
.panel{padding:18px}
.panel h2{margin:0 0 12px; font-size:18px}
.muted{color:var(--soft)}

/* FORMULAIRE EMPLOYÉ */
form#emp-form{display:grid; grid-template-columns:1fr 1fr; gap:12px}
form#emp-form .full{grid-column:1/-1}
label{display:block; font-size:12px; color:var(--soft); margin:4px 0}
input, select, textarea{
  width:100%; padding:12px 12px; border-radius:12px; border:1px solid rgba(148,163,184,.2);
  background:#0a1224; color:var(--text); outline:none; transition:.2s border, .2s box-shadow; box-shadow: inset 0 0 0 9999px rgba(255,255,255,.015)
}
textarea{min-height:82px}
input:focus, select:focus, textarea:focus{ border-color: rgba(94,234,212,.55); box-shadow: 0 0 0 3px rgba(6,182,212,.18)}
.row{display:grid; grid-template-columns:1fr 1fr; gap:12px}
.actions{display:flex; gap:8px; flex-wrap:wrap}
.btn{
  padding:10px 14px; border-radius:12px; border:1px solid rgba(148,163,184,.18); color:var(--text); background:#0b1429; cursor:pointer;
  display:inline-flex; align-items:center; gap:8px; transition:.2s transform, .2s background, .2s border-color;
}
.btn:hover{ transform: translateY(-1px); border-color:rgba(148,163,184,.35)}
.btn.primary{ background:linear-gradient(180deg, rgba(34,197,94,.95), rgba(34,197,94,.8)); color:#052e1c; border-color:transparent; font-weight:700 }
.btn.warn{ background:linear-gradient(180deg, rgba(245,158,11,.95), rgba(245,158,11,.8)); color:#1c1605; border-color:transparent; font-weight:700 }
.btn.ghost{ background:transparent }
.btn.danger{ background:linear-gradient(180deg, rgba(239,68,68,.95), rgba(239,68,68,.85)); color:#2e0909; border-color:transparent; font-weight:700 }
.btn.small{ padding:8px 10px; border-radius:10px; font-size:12px }

.photo-uploader{display:flex; gap:12px; align-items:center}
.avatar{width:64px; height:64px; border-radius:12px; background:#0b1429; border:1px dashed rgba(148,163,184,.25); display:grid; place-items:center; overflow:hidden}
.avatar img{width:100%; height:100%; object-fit:cover}

/* LISTE + BARRE OUTILS */
.toolbar{display:flex; gap:10px; align-items:center; justify-content:space-between; margin-bottom:12px}
.search{flex:1}

table{ width:100%; border-collapse:collapse; overflow:hidden; border-radius:12px;}
thead{background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.02));}
th, td{ text-align:left; padding:12px 12px; border-bottom:1px solid rgba(148,163,184,.12)}
tbody tr:hover{ background:rgba(148,163,184,.06)}
th.sortable{cursor:pointer}
th.sortable:after{content:"\25B4\25BE"; font-size:10px; opacity:.35; margin-left:6px}

.badge{padding:4px 8px; border-radius:999px; font-size:12px; border:1px solid rgba(148,163,184,.2); background:#0b1429}
.pill{padding:6px 10px; border-radius:999px; font-size:12px; background:rgba(34,197,94,.15); color:#a7f3d0; border:1px solid rgba(16,185,129,.3)}

/* MODAL DÉTAILS */
dialog{ border:none; border-radius:18px; width:min(100%, 980px); background:linear-gradient(180deg, rgba(10,18,36,.98), rgba(10,18,36,.98)); color:var(--text); box-shadow:var(--shadow)}
dialog::backdrop{ background: rgba(2,6,23,.6); backdrop-filter: blur(3px)}
.modal-head{display:flex; align-items:center; gap:12px; padding:16px 18px; border-bottom:1px solid rgba(148,163,184,.12)}
.modal-body{display:grid; grid-template-columns:300px 1fr; gap:16px; padding:16px 18px}
.modal-foot{display:flex; justify-content:space-between; gap:12px; padding:16px 18px; border-top:1px solid rgba(148,163,184,.12)}
@media (max-width:900px){ .modal-body{grid-template-columns: 1fr} }

.profile{background:linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.01)); border:1px solid rgba(148,163,184,.12); border-radius:16px; padding:16px}
.profile .big{width:120px; height:120px; border-radius:18px; overflow:hidden; border:1px solid rgba(148,163,184,.25)}
.kv{display:grid; grid-template-columns:120px 1fr; gap:8px; font-size:14px}
.kv div:nth-child(odd){ color:var(--soft) }
.kv div:nth-child(even){ font-weight:600 }

.leave-box{background:linear-gradient(180deg, rgba(34,197,94,.07), rgba(34,197,94,.04)); border:1px solid rgba(34,197,94,.25); border-radius:16px; padding:14px}
.leave-row{display:grid; grid-template-columns:repeat(3, 1fr); gap:10px;}
.leave-list{max-height:220px; overflow:auto; border:1px solid rgba(148,163,184,.12); border-radius:12px}
.leave-item{display:grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 2fr auto; gap:8px; padding:10px 12px; border-bottom:1px solid rgba(148,163,184,.08); font-size:14px}
.leave-item:last-child{border-bottom:none}

/* Impression (fiche employé) */
@media print{
  body{background:#fff}
  header, .wrap, dialog::backdrop, .modal-foot .btn:not(.print){ display:none !important }
  dialog{ position:static; transform:none; box-shadow:none; width:auto }
  .modal-body{ grid-template-columns: 1fr }
  .profile, .leave-box{ border:1px solid #ccc }
  .btn.print{ display:none }
}

  </style>
</head>
<body>
