      <div class="full" style="margin-top:6px">
        <h3 style="margin:8px 0 6px; font-size:14px">Paramètres de congés</h3>
        <div class="row">
          <div>
            <label for="methodConge">Méthode de calcul</label>
            <select id="methodConge">
              <option value="mois">2,5 jours par mois travaillé</option>
