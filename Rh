  </dialog>  <script>
    /* =====================
       STOCKAGE & UTILITAIRES
    ====================== */
    const LS_KEY = 'gp_employees_v1';
    let employees = loadEmployees();
    let sortState = { key: 'nom', dir: 'asc' };

    function loadEmployees(){
      try{ return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); }
      catch(e){ return [] }
    }
    function saveEmployees(){ localStorage.setItem(LS_KEY, JSON.stringify(employees)); }

    function uid(){ return Math.random().toString(36).slice(2) + Date.now().toString(36) }

    const fmtDA = new Intl.NumberFormat('fr-FR', { style:'currency', currency:'DZD', maximumFractionDigits:0 });

    function byKey(a,b,key){
      const va = (a[key] ?? '').toString().toLowerCase();
      const vb = (b[key] ?? '').toString().toLowerCase();
      if (va < vb) return -1; if (va > vb) return 1; return 0;
    }

    function dataURL(file){
      return new Promise((res, rej)=>{
        const r = new FileReader();
        r.onload = () => res(r.result);
        r.onerror = rej;
        r.readAsDataURL(file);
      })
    }

    function daysBetween(d1, d2){
      const a = new Date(d1); const b = new Date(d2);
      if (isNaN(a) || isNaN(b)) return 0;
      const ms = b - a; if (ms < 0) return 0;
      return Math.floor(ms / (1000*60*60*24)) + 1; // inclusif
    }
    function businessDaysBetween(d1, d2){
      let start = new Date(d1), end = new Date(d2);
      if (isNaN(start) || isNaN(end) || end < start) return 0;
      let count = 0; let cur = new Date(start);
      while(cur <= end){
        const day = cur.getDay(); // 0=dim,6=sam
        if (day !== 0 && day !== 6) count++;
        cur.setDate(cur.getDate()+1);
      }
      return count;
    }
    function monthsWorkedThisYear(dateEntree){
      const d = new Date(dateEntree); if (isNaN(d)) return 0;
      const now = new Date();
      const y = now.getFullYear();
      const start = new Date(y, 0, 1);
      const from = d > start ? d : start;
      if (from > now) return 0;
      // Mois complets entre 'from' et 'now' (approx: demi-mois ~ mois acquis prorata)
      let months = (now.getFullYear() - from.getFullYear())*12 + (now.getMonth() - from.getMonth());
      // si on a dépassé le jour du mois, on compte +1 comme mois en cours
      if (now.getDate() >= from.getDate()) months += 1;
      return Math.max(0, months);
    }

    function computeAccruedForYear(emp){
      const method = emp.methodConge || 'mois';
      if (method === 'quota'){
        return Number(emp.quotaAnnuel || 30);
      } else {
        const months = monthsWorkedThisYear(emp.dateEntree);
        const rate = Number(emp.accrualRate || 2.5);
        return +(months * rate).toFixed(2);
      }
    }

    function leavesTakenThisYear(emp){
      const y = new Date().getFullYear();
      return (emp.leaves||[]).filter(l => new Date(l.debut).getFullYear()===y).reduce((s,l)=> s + Number(l.jours||0), 0);
    }

    function updateCount(){
      const c = document.getElementById('count');
      const n = employees.length;
      c.textContent = n + (n>1? ' employés' : ' employé');
    }

    /* =====================
       RENDU TABLE
    ====================== */
    const tbody = document.querySelector('#emp-table tbody');

    function renderTable(){
      const q = document.getElementById('search').value.trim().toLowerCase();
      const rows = employees
        .slice()
        .sort((a,b)=> (sortState.dir==='asc'? byKey(a,b,sortState.key) : byKey(b,a,sortState.key)))
        .filter(e=>{
          const hay = [e.nom, e.prenom, e.email, e.banque, e.affectation].join(' ').toLowerCase();
          return hay.includes(q);
        })
        .map(e=>{
          const tr = document.createElement('tr');
          const imgTD = document.createElement('td');
          const ph = document.createElement('div');
          ph.className='avatar'; ph.style.width='42px'; ph.style.height='42px';
          if (e.photo){ const im = document.createElement('img'); im.src=e.photo; ph.appendChild(im) } else { ph.innerHTML='<span class="muted" style="font-size:11px">—</span>' }
          imgTD.appendChild(ph); tr.appendChild(imgTD);

          const tdNom = document.createElement('td'); tdNom.textContent = e.nom || '—'; tr.appendChild(tdNom);
          const tdPre = document.createElement('td'); tdPre.textContent = e.prenom || '—'; tr.appendChild(tdPre);
          const tdAf = document.createElement('td'); tdAf.innerHTML = e.affectation? `<span class="badge">${e.affectation}</span>` : '—'; tr.appendChild(tdAf);
          const tdBk = document.createElement('td'); tdBk.textContent = e.banque || '—'; tr.appendChild(tdBk);
          const tdSa = document.createElement('td'); tdSa.textContent = e.salaire? fmtDA.format(Number(e.salaire)) : '—'; tr.appendChild(tdSa);

          const actions = document.createElement('td');
          actions.innerHTML = `
            <div class="actions">
              <button class="btn small" data-act="edit" data-id="${e.id}">Modifier</button>
              <button class="btn small" data-act="details" data-id="${e.id}">Détails</button>
              <button class="btn small danger" data-act="del" data-id="${e.id}">Suppr.</button>
            </div>`;
          tr.appendChild(actions);

          return tr;
        });
      tbody.innerHTML='';
      rows.forEach(r=> tbody.appendChild(r));
      updateCount();
    }

    document.getElementById('search').addEventListener('input', renderTable);
    document.querySelectorAll('th.sortable').forEach(th=>{
      th.addEventListener('click', ()=>{
        const key = th.dataset.key;
        if (sortState.key === key){ sortState.dir = (sortState.dir==='asc'?'desc':'asc'); }
        else { sortState.key = key; sortState.dir='asc' }
        renderTable();
      })
    })

    /* =====================
       FORM LOGIC
    ====================== */
    const form = document.getElementById('emp-form');
    const saveBtn = document.getElementById('save-btn');
    const delBtn = document.getElementById('delete-btn');

    async function pickPhoto(){
      const f = document.getElementById('photo').files?.[0];
      if (!f) return '';
      const url = await dataURL(f);
      document.getElementById('photo-preview').innerHTML = `<img src="${url}" alt="photo"/>`;
      return url;
    }
    document.getElementById('photo').addEventListener('change', pickPhoto);
    document.getElementById('reset-photo').addEventListener('click', ()=>{
      document.getElementById('photo').value = '';
      document.getElementById('photo-preview').innerHTML = '<span class="muted">Aperçu</span>';
    })

    function formToEmployee(existing={}){
      return {
        id: existing.id || uid(),
        nom: nom.value.trim(),
        prenom: prenom.value.trim(),
        dateNaissance: dateNaissance.value || '',
        adresse: adresse.value.trim(),
        email: email.value.trim(),
        telephone: telephone.value.trim(),
        situationMaritale: situationMaritale.value,
        nombreEnfants: Number(nombreEnfants.value || 0),
        numeroAssurance: numeroAssurance.value.trim(),
        dateEntree: dateEntree.value,
        classement: classement.value.trim(),
        salaire: Number(salaire.value || 0),
        numeroCompte: numeroCompte.value.trim(),
        banque: banque.value,
        affectation: affectation.value,
        methodConge: methodConge.value,
        quotaAnnuel: Number(quotaAnnuel.value || 30),
        accrualRate: 2.5,
        photo: existing.photo || '',
        leaves: existing.leaves || []
      }
    }

    function fillForm(emp){
      document.getElementById('emp-id').value = emp.id || '';
      nom.value = emp.nom || '';
      prenom.value = emp.prenom || '';
      dateNaissance.value = emp.dateNaissance || '';
      adresse.value = emp.adresse || '';
      email.value = emp.email || '';
      telephone.value = emp.telephone || '';
      situationMaritale.value = emp.situationMaritale || '';
      nombreEnfants.value = emp.nombreEnfants ?? 0;
      numeroAssurance.value = emp.numeroAssurance || '';
      dateEntree.value = emp.dateEntree || '';
      classement.value = emp.classement || '';
      salaire.value = emp.salaire ?? '';
      numeroCompte.value = emp.numeroCompte || '';
      banque.value = emp.banque || '';
      affectation.value = emp.affectation || '';
      methodConge.value = emp.methodConge || 'mois';
      quotaAnnuel.value = emp.quotaAnnuel ?? 30;
      document.getElementById('photo-preview').innerHTML = emp.photo? `<img src="${emp.photo}"/>` : '<span class="muted">Aperçu</span>';
      delBtn.disabled = !emp.id;
    }

    saveBtn.addEventListener('click', async (e)=>{
      e.preventDefault();
      if (!form.reportValidity()) return;
      const currentId = document.getElementById('emp-id').value;
      let existing = employees.find(x=> x.id===currentId);
      let emp = formToEmployee(existing || {});
      if (document.getElementById('photo').files?.length){ emp.photo = await pickPhoto() }

      if (existing){
        Object.assign(existing, emp);
      } else {
        employees.push(emp);
      }
      saveEmployees();
      renderTable();
      form.reset();
      document.getElementById('photo-preview').innerHTML = '<span class="muted">Aperçu</span>';
      document.getElementById('emp-id').value='';
      delBtn.disabled = true;
    })

    document.getElementById('clear-btn').addEventListener('click', ()=>{
      document.getElementById('emp-id').value='';
      delBtn.disabled = true;
      document.getElementById('photo-preview').innerHTML = '<span class="muted">Aperçu</span>';
    })

    delBtn.addEventListener('click', ()=>{
      const id = document.getElementById('emp-id').value;
      if (!id) return;
      if (!confirm('Confirmer la suppression de cet employé ?')) return;
      employees = employees.filter(e=> e.id!==id);
      saveEmployees();
      renderTable();
      form.reset();
      document.getElementById('emp-id').value='';
      delBtn.disabled = true;
      document.getElementById('photo-preview').innerHTML = '<span class="muted">Aperçu</span>';
    })

    tbody.addEventListener('click', (e)=>{
      const btn = e.target.closest('button[data-act]'); if (!btn) return;
      const id = btn.dataset.id; const emp = employees.find(x=> x.id===id);
      if (!emp) return;
      if (btn.dataset.act==='edit'){
        fillForm(emp);
        window.scrollTo({ top:0, behavior:'smooth' });
      } else if (btn.dataset.act==='details'){
        openDetails(emp);
      } else if (btn.dataset.act==='del'){
        if (confirm('Supprimer cet employé ?')){
          employees = employees.filter(x=> x.id!==id); saveEmployees(); renderTable();
        }
      }
    })

    /* =====================
       DÉTAILS & CONGÉS
    ====================== */
    const modal = document.getElementById('details-modal');
    let currentEmp = null;

    function openDetails(emp){
      currentEmp = emp;
      document.getElementById('modal-name').textContent = `${emp.prenom || ''} ${emp.nom || ''}`.trim() || '—';
      document.getElementById('modal-sub').textContent = `${emp.affectation || '—'} • ${emp.banque || '—'}`;
      document.getElementById('modal-photo').innerHTML = emp.photo? `<img src="${emp.photo}"/>` : '';

      const set = (id, v)=> document.getElementById(id).textContent = v || '—';
      set('k-nom', emp.nom); set('k-prenom', emp.prenom); set('k-dn', emp.dateNaissance); set('k-adr', emp.adresse);
      set('k-mail', emp.email); set('k-tel', emp.telephone); set('k-sit', emp.situationMaritale); set('k-enf', emp.nombreEnfants);
      set('k-ass', emp.numeroAssurance); set('k-ent', emp.dateEntree); set('k-cls', emp.classement);
      set('k-sal', emp.salaire? fmtDA.format(Number(emp.salaire)) : '—'); set('k-cpt', emp.numeroCompte); set('k-bnk', emp.banque); set('k-af', emp.affectation);

      const acquis = computeAccruedForYear(emp);
      const pris = leavesTakenThisYear(emp);
      const restant = Math.max(0, +(acquis - pris).toFixed(2));
      document.getElementById('c-acquis').textContent = acquis;
      document.getElementById('c-pris').textContent = pris;
      document.getElementById('c-restant').textContent = restant;
      document.getElementById('c-method').textContent = (emp.methodConge==='quota') ? `Quota annuel ${emp.quotaAnnuel} j.` : `2,5 j/mois (depuis ${emp.dateEntree || '—'})`;

      renderLeaves();
      modal.showModal();
    }
    function closeModal(){ modal.close(); }

    function calcPreview(){
      const debut = document.getElementById('lv-debut').value;
      const fin = document.getElementById('lv-fin').value;
      const excl = document.getElementById('lv-excl-we').checked;
      const j = excl? businessDaysBetween(debut, fin) : daysBetween(debut, fin);
      alert(j? `${j} jour(s)` : 'Veuillez sélectionner une période valide.');
    }

    function addLeave(){
      if (!currentEmp) return;
      const type = document.getElementById('lv-type').value;
      const debut = document.getElementById('lv-debut').value;
      const fin = document.getElementById('lv-fin').value;
      const notes = document.getElementById('lv-notes').value.trim();
      const excl = document.getElementById('lv-excl-we').checked;
      const jours = excl? businessDaysBetween(debut, fin) : daysBetween(debut, fin);
      if (!jours){ alert('Période invalide.'); return; }
      const rec = { id: uid(), type, debut, fin, jours, exclWE: !!excl, notes };
      currentEmp.leaves = currentEmp.leaves || []; currentEmp.leaves.push(rec);
      // recalcul
      const acquis = computeAccruedForYear(currentEmp);
      const pris = leavesTakenThisYear(currentEmp);
      const restant = Math.max(0, +(acquis - pris).toFixed(2));
      document.getElementById('c-acquis').textContent = acquis;
      document.getElementById('c-pris').textContent = pris;
      document.getElementById('c-restant').textContent = restant;

      saveEmployees();
      renderLeaves();
      renderTable();
      document.getElementById('lv-notes').value='';
    }

    function renderLeaves(){
      const list = document.getElementById('leave-list');
      // Clear existing (keep header)
      list.querySelectorAll('.leave-item.dynamic').forEach(n=> n.remove());
      (currentEmp.leaves||[]).slice().sort((a,b)=> new Date(b.debut) - new Date(a.debut)).forEach(l=>{
        const row = document.createElement('div'); row.className='leave-item dynamic';
        row.innerHTML = `
          <div>${l.debut || '—'} → ${l.fin || '—'} ${l.exclWE? '<span class="badge" title="weekends exclus">WE‑</span>':''}</div>
          <div>${l.type}</div>
          <div>${l.jours}</div>
          <div>${new Date(l.debut).getFullYear()}</div>
          <div>${l.notes || ''}</div>
          <div><button class="btn small danger" data-lvdel="${l.id}">Suppr.</button></div>
        `;
        list.appendChild(row);
      })
      list.addEventListener('click', (ev)=>{
        const b = ev.target.closest('button[data-lvdel]'); if (!b) return;
        const id = b.dataset.lvdel;
        currentEmp.leaves = (currentEmp.leaves||[]).filter(x=> x.id!==id);
        saveEmployees();
        renderLeaves();
        renderTable();
      }, { once:true });
    }

    /* =====================
       EXPORT / IMPORT
    ====================== */
    document.getElementById('export-json').addEventListener('click', ()=>{
      const blob = new Blob([JSON.stringify(employees, null, 2)], { type:'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'employes.json'; a.click();
      URL.revokeObjectURL(a.href);
    })

    document.getElementById('import-json-input').addEventListener('change', async (e)=>{
      const f = e.target.files?.[0]; if (!f) return;
      const text = await f.text();
      try{
        const arr = JSON.parse(text);
        if (!Array.isArray(arr)) throw new Error('format invalide');
        // fusion simple (remplace si même id)
        const map = new Map(employees.map(x=>[x.id,x]));
        arr.forEach(x=> map.set(x.id || uid(), { leaves:[], ...x }));
        employees = Array.from(map.values());
        saveEmployees(); renderTable(); alert('Import effectué.');
      }catch(err){ alert('Fichier invalide.'); }
      e.target.value='';
    })

    document.getElementById('export-csv').addEventListener('click', ()=>{
      const headers = ['id','nom','prenom','dateNaissance','adresse','email','telephone','situationMaritale','nombreEnfants','numeroAssurance','dateEntree','classement','salaire','numeroCompte','banque','affectation','methodConge','quotaAnnuel'];
      const lines = [headers.join(';')];
      employees.forEach(e=>{
        const row = headers.map(h=> String(e[h] ?? '').replace(/[\n\r;]+/g,' '));
        lines.push(row.join(';'));
      })
      const blob = new Blob(["\uFEFF"+lines.join('\n')], { type:'text/csv;charset=utf-8' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download='employes.csv'; a.click();
      URL.revokeObjectURL(a.href);
    })

    document.getElementById('reset-app').addEventListener('click', ()=>{
      if (!confirm('Supprimer toutes les données locales ?')) return;
      employees = []; saveEmployees(); renderTable(); form.reset();
      document.getElementById('photo-preview').innerHTML = '<span class="muted">Aperçu</span>';
      document.getElementById('emp-id').value=''; delBtn.disabled=true;
    })

    /* =====================
       INIT
    ====================== */
    renderTable();

  </script></body>
</html>
